# 复制为 .env（chmod 600），只放在服务器上，不进仓库。

# 微信容器
WECHAT_CONTAINER=wechat-selkies
WX_CONFIG_DIR=/path/to/wechat-selkies/config
X11_SOCKET_DIR=/path/to/wechat-selkies/x11

# 内核 ↔ 桥接共享口令（openssl rand -hex 16）
FUXI_KERNEL_TOKEN=
# 主人 wxid，逗号分隔：主动搭话只找主人，主人还能用内核的管理指令。留空 = 不设主人（不会主动搭话）
FUXI_OWNER_WXIDS=
# 群里「叫她」的额外名字，逗号分隔（可选；内核人设别名另算）
FUXI_SELF_NAMES=

# 对外发送 API（浮屿发版等调用）；留空则不开启
FUXI_API_TOKEN=
FUXI_API_PORT=8790

# 初始白名单（chat_id，逗号分隔），只在桥接状态卷里还没有 allow.txt 时使用；
# 之后以 allow.txt 为准，改它或调 /allow 接口即时生效。空 = 谁都不回，* = 全部
FUXI_ALLOW=filehelper

# 0 = 关闭主动搭话（时间段/间隔/每日上限在内核配置 care 段，默认 9-12、14-23 点，约 90 分钟一次，每天最多 6 次）
FUXI_CARE=1

# 1 = 开启表情包（内核按回复情绪挑图，桥接发动图）；0 = 关闭；留空 = 不改内核里的设置
# 表情包库：在文件传输助手里先发一个表情，再发「/存表情 开心」（分类：开心 / 傲娇 / 炸毛）
FUXI_STICKERS=

# 防封节奏：自动回复每会话 / 全局每分钟上限；夜间静默时段（留空不静默）
FUXI_RATE_CHAT=6
FUXI_RATE_GLOBAL=20
FUXI_QUIET=

# 告警：Uptime Kuma 的 Push 监控地址（去掉 Kuma 给的 ?status=up&msg=OK&ping= 部分）；留空只写日志
KUMA_PUSH_URL=

# 1 = 文件传输助手里自己发的消息也交给内核（自测用，平时 0）
FUXI_REPLY_SELF=0

# 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
