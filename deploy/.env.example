# 复制为 .env（chmod 600），只放在服务器上，不进仓库。

# 微信容器
WECHAT_CONTAINER=wechat-selkies
WX_CONFIG_DIR=/path/to/wechat-selkies/config
X11_SOCKET_DIR=/path/to/wechat-selkies/x11

# 内核 ↔ 桥接共享口令（openssl rand -hex 16）
FUXI_KERNEL_TOKEN=
# 主人 wxid，逗号分隔（可选）
FUXI_OWNER_WXIDS=
# 群里「叫她」的额外名字，逗号分隔（可选；内核人设别名另算）
FUXI_SELF_NAMES=

# 对外发送 API（浮屿发版等调用）；留空则不开启
FUXI_API_TOKEN=
FUXI_API_PORT=8790

# 只响应这些会话（chat_id 或显示名，逗号分隔）；留空 = 所有私聊和 @ 它的群
FUXI_ALLOW=filehelper

# 1 = 文件传输助手里自己发的消息也交给内核（自测用，平时 0）
FUXI_REPLY_SELF=0

# 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
