# 复制为 .env（chmod 600），只放在服务器上，不进仓库。

# 微信容器
WECHAT_CONTAINER=wechat-selkies
WX_CONFIG_DIR=/path/to/wechat-selkies/config
X11_SOCKET_DIR=/path/to/wechat-selkies/x11

# 内核 ↔ 桥接共享口令（openssl rand -hex 16）
FUXI_KERNEL_TOKEN=

# 对外发送 API（浮屿发版等调用）；留空则不开启
FUXI_API_TOKEN=
FUXI_API_PORT=8790

# 行为设置（看图、主动搭话、主人、静默时段、限速、表情包…）不在这里：
# 在文件传输助手发 /设置 查看和修改，存在桥接状态卷的 settings.json，立即生效。

# 告警：Uptime Kuma 的 Push 监控地址（去掉 Kuma 给的 ?status=up&msg=OK&ping= 部分）；留空只写日志
KUMA_PUSH_URL=

# 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
